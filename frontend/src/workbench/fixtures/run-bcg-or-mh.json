 "r_code": "library(metafor)\n\ndat <- data.frame(\n  study = c(\"Aronson 1948\", \"Ferguson & Simes 1949\", \"Rosenthal et al 1960\", \"Hart & Sutherland 1977\", \"Frimodt-Moller et al 1973\", \"Stein & Aronson 1953\", \"Vandiviere et al 1973\", \"TPT Madras 1980\", \"Coetzee & Berjak 1968\", \"Rosenthal et al 1961\", \"Comstock et al 1974\", \"Comstock & Webster 1969\", \"Comstock et al 1976\"),\n  ai = c(4, 6, 3, 62, 33, 180, 8, 505, 29, 17, 186, 5, 27),\n  n1i = c(123, 306, 231, 13598, 5069, 1541, 2545, 88391, 7499, 1716, 50634, 2498, 16913),\n  ci = c(11, 29, 11, 248, 47, 372, 10, 499, 45, 65, 141, 3, 29),\n  n2i = c(139, 303, 220, 12867, 5808, 1451, 629, 88391, 7277, 1665, 27338, 2341, 17854),\n  stringsAsFactors = FALSE\n)\n\nfit <- rma.mh(measure = \"OR\", ai = ai, n1i = n1i, ci = ci, n2i = n2i, slab = study, level = 95.0, data = dat)\nprint(fit)\n\n# back on the ratio scale\npred <- predict(fit, transf = exp)\nprint(pred)\n\n# funnel plot: the 95% region is centred on the common-effect estimate (decision 0020)\nfunnel(fit, level = 95)\n",
